# for local environment
# COUCHBASE_CONNECT_OPTIONS=couchbase://localhost/table-reservation@admin:123456
# for docker environment
COUCHBASE_CONNECT_OPTIONS=couchbase://couchbase/table-reservation@admin:123456
JWT_SECRET=table-reservation-jwt-secret
JWT_EXPIRES_IN=10h
PORT=4000

# CORS 配置 - 生产环境允许的域名，支持局域网访问
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://192.168.12.17:3000